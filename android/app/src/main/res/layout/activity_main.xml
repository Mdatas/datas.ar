<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0E1116">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Datas.ar"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="#74ACDF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tagline"
            android:textColor="#8B95A7"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#8B95A7"
            android:text="@string/stopped" />

        <!-- my computers: use the AI of a linked computer through the encrypted link -->
        <LinearLayout style="@style/Card" android:orientation="vertical">
            <TextView style="@style/CardTitle" android:text="@string/section_computers" />
            <TextView
                android:id="@+id/computersHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#8B95A7"
                android:text="@string/computers_hint" />
            <LinearLayout
                android:id="@+id/computers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <Button
                android:id="@+id/linkBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/link_computer" />
        </LinearLayout>

        <!-- 1. device -->
        <LinearLayout style="@style/Card" android:orientation="vertical">
            <TextView style="@style/CardTitle" android:text="@string/section_device" />
            <TextView
                android:id="@+id/deviceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textColor="#E6E9EE" />
            <TextView
                android:id="@+id/headroomLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="13sp"
                android:textColor="#8B95A7" />
            <SeekBar
                android:id="@+id/headroom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="11"
                android:progress="7" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/context_label"
                    android:textColor="#8B95A7"
                    android:textSize="13sp" />
                <Spinner
                    android:id="@+id/context"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />
                <CheckBox
                    android:id="@+id/kv8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="KV 8-bit"
                    android:textColor="#E6E9EE"
                    android:textSize="13sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/deviceNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#F2A93B" />
        </LinearLayout>

        <!-- 2. recommendation -->
        <LinearLayout style="@style/Card" android:orientation="vertical">
            <TextView style="@style/CardTitle" android:text="@string/section_reco" />
            <TextView
                android:id="@+id/recoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#E6E9EE" />
            <TextView
                android:id="@+id/recoChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#74ACDF" />
            <ProgressBar
                android:id="@+id/fitBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100" />
            <TextView
                android:id="@+id/recoNeeds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#8B95A7" />
            <TextView
                android:id="@+id/recoLicense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#8B95A7" />
            <Button
                android:id="@+id/installRun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/install_run" />
            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:visibility="gone" />
            <TextView
                android:id="@+id/progressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#8B95A7" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/others"
                android:textColor="#8B95A7"
                android:textSize="13sp" />
            <LinearLayout
                android:id="@+id/others"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/license_note"
                android:textColor="#8B95A7"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3. chat -->
        <LinearLayout style="@style/Card" android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView style="@style/CardTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/section_chat" />
                <Button
                    android:id="@+id/stopBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stop"
                    android:enabled="false" />
            </LinearLayout>
            <WebView
                android:id="@+id/web"
                android:layout_width="match_parent"
                android:layout_height="560dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/chatHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#8B95A7"
                android:text="@string/stopped" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
